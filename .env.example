# ============================================================================
#  Avenir environment variables
#  Copy this file to `.env.local` and fill in the values from your Supabase
#  project (Dashboard → Project Settings → API). Until you do, Avenir runs in
#  a fully-browsable demo mode with sample data.
# ============================================================================

# Your project's URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The public "anon" key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------------------------
#  Claude / Anthropic (optional) — powers generative, conversational voice
#  coaching. Without it, Avenir uses a built-in local coach responder, so voice
#  still works with zero setup. Add a key to make the coach fully generative.
#  Get one at https://console.anthropic.com/ — keep it SECRET (no NEXT_PUBLIC_
#  prefix, so it never reaches the browser).
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8 (highest quality).
# For lower latency + cost on real-time coaching, claude-haiku-4-5 is a great fit.
ANTHROPIC_COACH_MODEL=claude-opus-4-8

# ----------------------------------------------------------------------------
#  Stripe (optional) — real subscriptions for Avenir Premium. Without these,
#  /pricing falls back to flipping the plan directly so the gate stays testable.
#  Create the product + recurring price in the Stripe dashboard first.
# ----------------------------------------------------------------------------
# Secret key, from Stripe → Developers → API keys. Starts sk_test_ / sk_live_.
STRIPE_SECRET_KEY
# The recurring price the Premium plan bills against. Starts price_.
STRIPE_PREMIUM_PRICE_ID
# Signing secret for /api/stripe/webhook, from Stripe → Developers → Webhooks.
# Starts whsec_.
STRIPE_WEBHOOK_SECRET

# Supabase service-role key (Project Settings → API). The Stripe webhook has no
# user session, so it needs this to grant Premium. SECRET — never expose it.
SUPABASE_SERVICE_ROLE_KEY
